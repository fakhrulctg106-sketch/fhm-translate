<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. Full Circular FHM Button (When active/restored) -->
    <RelativeLayout
        android:id="@+id/fullBubbleLayout"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_circular_bubble"
        android:elevation="12dp"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="FHM"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/statusIndicator"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_indicator_active" />
    </RelativeLayout>

    <!-- 2. Small Subtle Edge Handle (When idle at screen edge - NO text) -->
    <LinearLayout
        android:id="@+id/collapsedHandle"
        android:layout_width="14dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_collapsed_handle"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Subtle minimalist grip indicator (No text) -->
        <View
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_grip_bar" />
    </LinearLayout>

</FrameLayout>
